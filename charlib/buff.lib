library (project1_buffer){
  technology : cmos ;
  delay_model : table_lookup ;
  bus_naming_style : "%s-%d" ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  leakage_power_unit : "1nW" ;
  current_unit : "1uA" ;
  pulling_resistance_unit : "1uA" ;
  capacitive_load_unit (1, pF);
  nom_process : 1.00 ;
  nom_voltage : 1.80 ;
  nom_temperature : 25 ;
  slew_upper_threshold_pct_rise : 0.80 ;
  slew_lower_threshold_pct_rise : 0.20 ;
  slew_upper_threshold_pct_fall : 0.80 ;
  slew_lower_threshold_pct_fall : 0.20 ;
  input_threshold_pct_rise : 0.50 ;
  input_threshold_pct_fall : 0.50 ;
  output_threshold_pct_rise : 0.50 ;
  output_threshold_pct_fall : 0.50 ;
  operating_conditions (typical) {
    process : 1.00 ;
    voltage : 1.80 ;
    temperature : 25 ;
  } /* end operating_conditions */
  lu_table_template (delay_template_4x4) {
    variable_1 : total_output_net_capacitance ;
    variable_2 : input_net_transition ;
    index_1 ("1.0, 2.0, 3.0, 4.0");
    index_2 ("1.0, 2.0, 3.0, 4.0");
  } /* end lu_table_template */
  cell (project1_bufferckt) {
    area : 0.00 ;
    pg_pin (VDD) {
      voltage_name : VDD ;
      pg_type : primary_power ;
    } /* end pg_pin */
    pg_pin (VSS) {
      voltage_name : VSS ;
      pg_type : primary_ground ;
    } /* end pg_pin */
    pin (IN) {
      direction : input ;
      capacitance : 0.002211 ;
    } /* end pin */
    pin (OUT) {
      direction : output ;
      function : "OUT = IN" ;
      timing () {
        related_pin : IN ;
        timing_type : combinational_fall ;
        cell_fall (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.052645, 0.068532, 0.086350, 0.109766" \
            "0.073767, 0.089684, 0.107826, 0.133024" \
            "0.098399, 0.114429, 0.132630, 0.158568" \
            "0.291821, 0.308106, 0.326474, 0.352611" \
          ) ;
        } /* end cell_fall */
        fall_transition (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.020257, 0.020928, 0.023111, 0.028606" \
            "0.044524, 0.044683, 0.045944, 0.049827" \
            "0.075543, 0.075671, 0.076217, 0.078314" \
            "0.327327, 0.327341, 0.327402, 0.327600" \
          ) ;
        } /* end fall_transition */
      } /* end timing */
      timing () {
        related_pin : IN ;
        timing_type : combinational_rise ;
        rise_transition (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.019718, 0.020100, 0.022836, 0.033397" \
            "0.042631, 0.042685, 0.044085, 0.048392" \
            "0.072357, 0.072381, 0.072843, 0.074196" \
            "0.313321, 0.313343, 0.313337, 0.313740" \
          ) ;
        } /* end rise_transition */
        cell_rise (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.051348, 0.065218, 0.081495, 0.104251" \
            "0.068987, 0.082643, 0.099291, 0.122246" \
            "0.089832, 0.103518, 0.120149, 0.142745" \
            "0.254346, 0.268119, 0.284710, 0.307156" \
          ) ;
        } /* end cell_rise */
      } /* end timing */
    } /* end pin */
    leakage_power () {
      when : IN ;
      value : 0.116547 ;
    } /* end leakage_power */
    leakage_power () {
      when : "!IN" ;
      value : 0.116547 ;
    } /* end leakage_power */
  } /* end cell */
} /* end library */