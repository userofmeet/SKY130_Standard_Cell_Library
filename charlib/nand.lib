library (project1_nand){
  technology : cmos ;
  delay_model : table_lookup ;
  bus_naming_style : "%s-%d" ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  leakage_power_unit : "1nW" ;
  current_unit : "1uA" ;
  pulling_resistance_unit : "1uA" ;
  capacitive_load_unit (1, pF);
  nom_process : 1.00 ;
  nom_voltage : 1.80 ;
  nom_temperature : 25 ;
  slew_upper_threshold_pct_rise : 0.80 ;
  slew_lower_threshold_pct_rise : 0.20 ;
  slew_upper_threshold_pct_fall : 0.80 ;
  slew_lower_threshold_pct_fall : 0.20 ;
  input_threshold_pct_rise : 0.50 ;
  input_threshold_pct_fall : 0.50 ;
  output_threshold_pct_rise : 0.50 ;
  output_threshold_pct_fall : 0.50 ;
  operating_conditions (typical) {
    process : 1.00 ;
    voltage : 1.80 ;
    temperature : 25 ;
  } /* end operating_conditions */
  lu_table_template (delay_template_4x4) {
    variable_1 : total_output_net_capacitance ;
    variable_2 : input_net_transition ;
    index_1 ("1.0, 2.0, 3.0, 4.0");
    index_2 ("1.0, 2.0, 3.0, 4.0");
  } /* end lu_table_template */
  cell (project1_nand) {
    area : 0.00 ;
    pg_pin (VDD) {
      voltage_name : VDD ;
      pg_type : primary_power ;
    } /* end pg_pin */
    pin (A) {
      direction : input ;
      capacitance : 0.002152 ;
    } /* end pin */
    pg_pin (VSS) {
      voltage_name : VSS ;
      pg_type : primary_ground ;
    } /* end pg_pin */
    pin (B) {
      direction : input ;
      capacitance : 0.002592 ;
    } /* end pin */
    pin (OUT) {
      direction : output ;
      function : "OUT = !(!A & B)" ;
      timing () {
        related_pin : A ;
        timing_type : combinational_fall ;
        fall_transition (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.022252, 0.022805, 0.024448, 0.033303" \
            "0.042477, 0.042769, 0.043942, 0.048235" \
            "0.067979, 0.068068, 0.068465, 0.071422" \
            "0.274975, 0.274998, 0.275120, 0.275537" \
          ) ;
        } /* end fall_transition */
        cell_fall (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.055103, 0.071186, 0.089563, 0.114391" \
            "0.072366, 0.088467, 0.107141, 0.133829" \
            "0.092521, 0.108707, 0.127370, 0.154907" \
            "0.249886, 0.266256, 0.285078, 0.312673" \
          ) ;
        } /* end cell_fall */
      } /* end timing */
      timing () {
        related_pin : A ;
        timing_type : combinational_rise ;
        cell_rise (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.060562, 0.074502, 0.091743, 0.116434" \
            "0.078644, 0.092418, 0.109732, 0.135960" \
            "0.099897, 0.113623, 0.130820, 0.156358" \
            "0.265065, 0.278974, 0.296235, 0.321391" \
          ) ;
        } /* end cell_rise */
        rise_transition (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.024719, 0.024872, 0.027636, 0.037151" \
            "0.047649, 0.047695, 0.048510, 0.053063" \
            "0.077355, 0.077402, 0.077690, 0.079553" \
            "0.318265, 0.318285, 0.318312, 0.318668" \
          ) ;
        } /* end rise_transition */
      } /* end timing */
      timing () {
        related_pin : B ;
        timing_type : combinational_rise ;
        cell_rise (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.034543, 0.050398, 0.070137, 0.098868" \
            "0.052018, 0.067988, 0.089070, 0.125721" \
            "0.073136, 0.089254, 0.110173, 0.151847" \
            "0.238492, 0.254962, 0.275857, 0.318086" \
          ) ;
        } /* end cell_rise */
        rise_transition (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.032555, 0.033990, 0.043572, 0.068389" \
            "0.056380, 0.056443, 0.062468, 0.086147" \
            "0.086372, 0.086447, 0.088857, 0.106065" \
            "0.327530, 0.327545, 0.327610, 0.327678" \
          ) ;
        } /* end rise_transition */
      } /* end timing */
      timing () {
        related_pin : B ;
        timing_type : combinational_fall ;
        cell_fall (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.033969, 0.046691, 0.058320, 0.074023" \
            "0.050369, 0.063483, 0.077712, 0.099464" \
            "0.070245, 0.083636, 0.098507, 0.125068" \
            "0.227384, 0.241224, 0.256611, 0.287360" \
          ) ;
        } /* end cell_fall */
        fall_transition (delay_template_4x4) {
          index_1 ("0.001000, 0.005000, 0.010000, 0.050000") ;
          index_2 ("0.010000, 0.050000, 0.100000, 0.200000") ;
          values ( \
            "0.020870, 0.021957, 0.028021, 0.042009" \
            "0.041756, 0.042088, 0.045901, 0.061473" \
            "0.067657, 0.067741, 0.070056, 0.082741" \
            "0.274974, 0.274997, 0.275090, 0.275861" \
          ) ;
        } /* end fall_transition */
      } /* end timing */
    } /* end pin */
    leakage_power () {
      when : "!A & B" ;
      value : 0.229797 ;
    } /* end leakage_power */
    leakage_power () {
      when : "A & !B" ;
      value : 0.119808 ;
    } /* end leakage_power */
    leakage_power () {
      when : "!A & !B" ;
      value : 0.019714 ;
    } /* end leakage_power */
    leakage_power () {
      when : "A & B" ;
      value : 0.119841 ;
    } /* end leakage_power */
  } /* end cell */
} /* end library */